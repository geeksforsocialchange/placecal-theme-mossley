#!/usr/bin/env bash
# Writes <core>/Gemfile.mossley-dev: core's own Gemfile with this engine taken
# from the checkout and the Trans Dimension engine from its checkout when one
# sits beside core, else from core's pinned tag, so a single boot loads two
# extensions at once. That is the point of
# this file as well as a convenience: two engines registering two themes in one
# process is the thing WP 5.1 has to prove.
#
# The generated file is local to the core checkout: do not commit it there
# (add it to core's .git/info/exclude).
#
# Usage:
#   bin/mossley-dev-gemfile [core-checkout] [mossley-path] [transdimension-path]
#
# All three arguments have defaults; PLACECAL_CORE_PATH is honoured for the
# first, and the engine paths are resolved as core sees them.
set -euo pipefail

core=${1:-${PLACECAL_CORE_PATH:-../PlaceCal}}
mossley=${2:-../placecal-theme-mossley}
transdimension=${3:-../placecal-theme-transdimension}

if [ ! -f "$core/Gemfile" ]; then
	echo "No Gemfile at $core: pass the PlaceCal checkout as the first argument." >&2
	exit 1
fi

if [ -f "$transdimension/placecal-theme-transdimension.gemspec" ] || [ -f "$core/$transdimension/placecal-theme-transdimension.gemspec" ]; then
	td_line="gem 'placecal-theme-transdimension', path: '$transdimension'"
	td_note="from the path checkout"
else
	# No Trans Dimension checkout beside core (CI, for instance): keep core's
	# pinned git tag for it, so two engines still load in one process.
	td_line=""
	td_note="from core's pinned tag"
fi

cat > "$core/Gemfile.mossley-dev" <<RUBY
# Generated by bin/mossley-dev-gemfile in the Mossley theme engine. Local only,
# do not commit. Core with the Mossley engine from this checkout and the Trans
# Dimension engine $td_note, so one boot loads two engines.
core = File.read(File.expand_path('Gemfile', __dir__))
core = core.gsub(/^\s*gem 'placecal-theme-mossley'.*\n/, '')
$( [ -n "$td_line" ] && echo "core = core.gsub(/^\\s*gem 'placecal-theme-transdimension'.*\\n/, '')" )
instance_eval(core, File.expand_path('Gemfile', __dir__), 1)
gem 'placecal-theme-mossley', path: '$mossley'
$td_line
RUBY

echo "Wrote $core/Gemfile.mossley-dev (mossley: $mossley, transdimension: $td_note)"
