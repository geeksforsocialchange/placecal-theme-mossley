#!/usr/bin/env bash
# Writes <core>/Gemfile.mossley-dev: core's own Gemfile with the whole
# `group :extensions` block replaced by path entries for BOTH PlaceCal theme
# engines, so a single boot loads two extensions at once. That is the point of
# this file as well as a convenience: two engines registering two themes in one
# process is the thing WP 5.1 has to prove.
#
# The generated file is local to the core checkout: do not commit it there
# (add it to core's .git/info/exclude).
#
# Usage:
#   bin/mossley-dev-gemfile [core-checkout] [mossley-path] [transdimension-path]
#
# All three arguments have defaults; PLACECAL_CORE_PATH is honoured for the
# first, and the engine paths are resolved as core sees them.
set -euo pipefail

core=${1:-${PLACECAL_CORE_PATH:-../PlaceCal}}
mossley=${2:-../placecal-theme-mossley}
transdimension=${3:-../placecal-theme-transdimension}

if [ ! -f "$core/Gemfile" ]; then
	echo "No Gemfile at $core: pass the PlaceCal checkout as the first argument." >&2
	exit 1
fi

cat > "$core/Gemfile.mossley-dev" <<RUBY
# Generated by bin/mossley-dev-gemfile in the Mossley theme engine. Local only,
# do not commit. Core with BOTH theme extensions from path checkouts instead of
# the pinned git tags, so one boot loads two engines.
core = File.read(File.expand_path('Gemfile', __dir__))
core = core.sub(/^group :extensions do.*?^end\n/m, '')
instance_eval(core, File.expand_path('Gemfile', __dir__), 1)
gem 'placecal-theme-transdimension', path: '$transdimension'
gem 'placecal-theme-mossley', path: '$mossley'
RUBY

echo "Wrote $core/Gemfile.mossley-dev (mossley: $mossley, transdimension: $transdimension)"
